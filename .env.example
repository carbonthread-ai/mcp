# Where this server is reached from outside (no trailing slash). The connector URL is PUBLIC_URL + /mcp.
PUBLIC_URL=http://localhost:8787
PORT=8787

# The Fabric backend, including its /api prefix (the old name THREADOS_API_URL is still read if this is unset)
FABRIC_API_URL=http://localhost:8000/api
# The Fabric web app, linked from tool results so reviews are finished there (old name THREADOS_APP_URL also read)
FABRIC_APP_URL=http://localhost:5173

# The Fabric database, for connections, codes and tokens (tables named mcp_* in public, which the backend's
# Alembic env skips). Leave empty locally to use the in-memory store; required when NODE_ENV=production.
DATABASE_URL=

# Encrypts the Fabric tokens held for each connection. 32 bytes, hex or base64: `openssl rand -hex 32`.
# Changing it disconnects everyone (they reconnect by signing in again).
TOKEN_ENCRYPTION_KEY=

# Optional
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_SECONDS=2592000
# Limit https redirect URIs for self-registered apps to these hosts (and their subdomains), e.g.
# ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,openai.com
# Custom URI schemes desktop editors use for the OAuth callback
# EXTRA_REDIRECT_SCHEMES=cursor,vscode,vscode-insiders,windsurf,zed
# Behind Railway's proxy; set false when nothing sits in front
# TRUST_PROXY=true
